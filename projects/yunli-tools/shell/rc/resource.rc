// YunLi工具箱 .aip 资源
// plugin.pipl 由官方 tools/pipl/create_pipl.py 生成(见 build.ps1)

// PIPL: 资源类型 "pipl" / 名称 "plugin"(同 SDK EmptyPanel 示例;
// Windows 资源名/类型匹配不区分大小写,等价于字醒的 PIPL/PLUGIN)
plugin pipl "plugin.pipl"

#ifdef YUNMAN_EMBED_PAYLOAD
101 10 "payload.bin"    // 发布: 嵌入 YunLiCore.exe (类型10/名称101, 同字醒)
#endif

// 停靠面板收起时的图标(SVG,2x)
200 svg "panel-light.svg"
201 svg "panel-dark.svg"
